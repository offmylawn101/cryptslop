{
  "name": "cryptslop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Low-poly retro co-op roguelike FPS with Source-style movement, built for Wavedash.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --target=es2022 --minify --outfile=web/main.bundle.js",
    "watch": "esbuild src/main.js --bundle --format=esm --target=es2022 --sourcemap --outfile=web/main.bundle.js --watch",
    "serve": "node tools/serve.cjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
